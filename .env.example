# false 로 설정하면 실제 인쇄(window.print) 호출 없이 로딩/결과 화면만 진행합니다. (개발용)
NEXT_PUBLIC_PRINT_ENABLED=true

# 인쇄 로딩 화면 최소 유지 시간(ms). 프린터 인화 시간에 맞춰 조절하세요.
NEXT_PUBLIC_PRINT_DURATION_MS=15000

# 한 용지에 가로로 나란히 인쇄할 같은 사진 장 수
NEXT_PUBLIC_PRINT_COPIES=2

# 인쇄 용지 크기(@page size). 예: landscape, "A4 landscape", "8in 6in"
NEXT_PUBLIC_PRINT_PAGE_SIZE=landscape

# 결과 화면에서 처음으로 자동 복귀까지 걸리는 시간(초)
NEXT_PUBLIC_RESULT_IDLE_SECONDS=30
